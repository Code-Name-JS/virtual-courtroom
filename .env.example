# 06. MVP 범위 · 기술 스택 > 환경 변수
# 이 파일을 .env로 복사한 뒤 값을 채워 주세요. .env는 저장소에 올리지 않습니다.

# 사이트 주소 (이메일 속 링크에 사용)
SITE_URL=http://localhost:3000

# Caddy가 HTTPS 인증서를 발급받을 도메인 (Docker Compose 배포용)
SITE_DOMAIN=localhost

# PostgreSQL
POSTGRES_USER=courtroom
POSTGRES_PASSWORD=change-me
POSTGRES_DB=courtroom
DATABASE_URL=postgresql://courtroom:change-me@localhost:5432/courtroom

# 비밀 키 (각각 32자 이상의 무작위 문자열. 예: openssl rand -hex 32)
SESSION_SECRET=
# IP 해시용 비밀 키. 사이트를 폐쇄할 때 반드시 폐기합니다 (05 개인정보 정책)
IP_HASH_SECRET=

# 실제 접속 IP를 읽을 헤더. 앞단 프록시(Caddy)가 덮어쓰는 헤더만 지정하세요.
# 사용자가 직접 보낸 X-Forwarded-For는 얼마든지 속일 수 있으므로 쓰지 않습니다.
CLIENT_IP_HEADER=x-real-ip

# 이메일 (비워 두면 이메일 내용을 서버 로그에 출력합니다. 개발용)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Virtual Courtroom <no-reply@example.com>"

# 최종 변론인 AI 추천. 비워 두면 AI 추천 없이 운영자가 배심원의 추천 이유를 참고해 선정합니다.
# - AI_PROVIDER=anthropic: Claude (Anthropic 공식 SDK). AI_API_KEY가 없으면 ANTHROPIC_API_KEY를 씁니다. AI_MODEL 기본값 claude-opus-5-5
# - AI_PROVIDER=openai-compatible: OpenAI 호환 채팅 API를 지원하는 AI 서비스. AI_API_URL(…/chat/completions 전체 주소), AI_API_KEY, AI_MODEL 필요
AI_PROVIDER=
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# 증거 이미지를 저장할 폴더. 비워 두면 저장소의 uploads 폴더 (Docker Compose에서는 uploads 볼륨을 씀)
# 사이트를 폐쇄하면 이 폴더의 이미지도 함께 파기됩니다
UPLOAD_DIR=

# 이 이메일로 가입한 계정이 첫 운영자가 됩니다
OPERATOR_EMAIL=

# 이용약관 · 개인정보처리방침에 표시할 운영자 정보
OPERATOR_NAME=
OPERATOR_CONTACT_EMAIL=
# 개인정보 처리를 맡기는 업체 (예: "이메일 발송: OO, 서버: OO")
PRIVACY_PROCESSORS=
# 출시 전에 법률 전문가의 검토를 받아 이용약관과 개인정보처리방침을 고쳤다면 true로 바꾸세요.
# false인 동안에는 두 페이지에 "기본 템플릿" 안내가 표시됩니다.
LEGAL_DOCS_REVIEWED=false

# 개발·시연용 설정. 실제 배포(NODE_ENV=production)에서는 무시됩니다.
DEMO_MODE=false
# DEMO_MODE=true일 때만 IP 하나에 계정 하나 규칙을 끌 수 있습니다 (테스트 계정 여러 개 만들기용)
DISABLE_IP_RULE=false
